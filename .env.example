# Only configure these in the private Vercel environment or a local ignored .env.
D2R_REPO_TOKEN=
D2R_DATA_KEY=
D2R_SESSION_SECRET=
D2R_AUTH_ACCOUNTS=
# Optional viewer password, as a salted hash.
D2R_SHARED_PASSWORD_HASH=
D2R_DISABLE_SHARED_LOGIN=
# Local tests only. Vercel always uses the GitHub backend.
D2R_LOCAL_DATA_DIR=
CRON_SECRET=
OPENAI_ADMIN_KEY=
ANTHROPIC_ADMIN_KEY=
GITHUB_BILLING_TOKEN=
VERCEL_BILLING_TOKEN=
# Opt-in to charges from an existing Google Billing export only after approval.
GCP_BILLING_JOB_PROJECT=
GCP_BILLING_TABLE=
GCP_BILLING_LOCATION=
GCP_GEMINI_SKU_IDS=
GCP_BILLING_CREDENTIALS=
GCP_BILLING_MAX_BYTES=
# Optional Gmail read-only import. Use a dedicated label and approved sender/signer pairs.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_RECEIPTS_LABEL=
GMAIL_RECEIPTS_SENDERS=
